#!/bin/bash

PROJECT_HOME="/home/ajisoo/Development/Sad-Bot"
LOCAL="local"
LOG_FILE="$LOCAL/logs.txt"

cd "$PROJECT_HOME"

pid=$(pgrep -f -o "python3 bot.py")

if [[ -z "$pid" ]]; then
	kill -9 "$pid"
fi

git pull &>> "$LOG_FILE"

source ./my-venv/bin/activate
python3 -m pip install -r requirements.txt
python3 bot.py &>> "$LOG_FILE" &
